# Copy to .env and fill in. Server reads .env on startup.

# Server
PORT=8080
SESSION_SECRET=change-me-to-32-random-bytes

# Database
DATABASE_PATH=./diet-app.db

# Default AI source: openai | openrouter | ollama | lmstudio | local
DEFAULT_AI_SOURCE=openrouter
DEFAULT_AI_MODEL=meta-llama/llama-3.3-70b-instruct:free

# Provider API keys (leave blank if not using that source)
OPENAI_API_KEY=
OPENROUTER_API_KEY=
OLLAMA_BASE_URL=http://localhost:11434/v1
LMSTUDIO_BASE_URL=http://localhost:1234/v1

# Local llama.cpp (for source=local)
# Path to a GGUF model file (e.g. llama-3.2-3b-instruct-q4_k_m.gguf).
# If blank, a small default model (SmolLM2-135M) is auto-downloaded on first use.
LOCAL_MODEL_PATH=
# Path to llama.cpp shared libraries. If blank, they are auto-downloaded on
# first use (CPU build, or CUDA/ROCm if a GPU is detected) — no manual setup needed.
YZMA_LIB=

# OpenRouter app attribution (optional)
OPENROUTER_APP_URL=
OPENROUTER_APP_NAME=DietApp

# Anonymous mode (skip auth, like the old Supabase fallback). false = require sign-in.
ALLOW_ANONYMOUS=true
